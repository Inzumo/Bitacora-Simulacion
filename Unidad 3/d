import * as THREE from 'three';
import {
    Fn,
    float,
    vec3,
    uniform,
    instanceIndex,
    instancedArray,
    snoiseVec3
} from 'three/tsl';

/**
 * Unidad 3 - Instrumento de Fuerzas
 *
 * Sistema de partículas completamente calculado en GPU.
 *
 * Fuerzas:
 *  1. Drag lineal
 *  2. Atracción / repulsión radial suavizada
 *  3. Vórtice tangencial
 *  4. Curl noise mediante diferencias finitas
 *
 * Integrador:
 *  v(t + dt) = v(t) + a(t) * dt
 *  p(t + dt) = p(t) + v(t + dt) * dt
 *
 * Nota:
 * - Las posiciones y velocidades son storage buffers.
 * - No se hace readback de los datos durante la simulación.
 * - El CPU solamente modifica uniforms.
 */

const DEFAULT_PARTICLE_COUNT = 20000;

const DEFAULTS = {
    particleCount: DEFAULT_PARTICLE_COUNT,

    mass: 1.0,
    drag: 0.18,

    radialStrength: 5.0,
    radialSoftening: 0.7,

    vortexStrength: 1.5,
    vortexSoftening: 0.8,

    turbulenceStrength: 0.0,
    turbulenceFrequency: 0.35,

    maxSpeed: 12.0,

    dt: 0.016,

    initialSpread: 10.0,
    initialVelocity: 0.8,

    attractorPosition: new THREE.Vector3(0, 0, 0),

    mode: 'performance',
    scenario: 3
};


/**
 * Generador determinista sencillo.
 * Permite que el mismo experimento pueda repetirse.
 */
function seededRandom(seed) {
    let value = seed >>> 0;

    return () => {
        value += 0x6D2B79F5;

        let t = value;
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);

        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
}


/**
 * Inicializa posiciones y velocidades en CPU únicamente una vez.
 * Después de ser subidos, permanecen en GPU.
 */
function createInitialData(count, spread, velocityMagnitude) {

    const positions = new Float32Array(count * 3);
    const velocities = new Float32Array(count * 3);

    const random = seededRandom(42);

    for (let i = 0; i < count; i++) {

        const radius = Math.sqrt(random()) * spread;
        const angle = random() * Math.PI * 2;

        const x = Math.cos(angle) * radius;
        const y = Math.sin(angle) * radius;

        const z = (random() - 0.5) * spread * 0.35;

        positions[i * 3 + 0] = x;
        positions[i * 3 + 1] = y;
        positions[i * 3 + 2] = z;

        const velocityAngle = random() * Math.PI * 2;
        const speed =
            velocityMagnitude *
            (0.35 + random() * 0.65);

        velocities[i * 3 + 0] =
            Math.cos(velocityAngle) * speed;

        velocities[i * 3 + 1] =
            Math.sin(velocityAngle) * speed;

        velocities[i * 3 + 2] =
            (random() - 0.5) * speed * 0.15;
    }

    return {
        positions,
        velocities
    };
}


/**
 * Crea la simulación GPU.
 */
export function createSimulation(options = {}) {

    const settings = {
        ...DEFAULTS,
        ...options
    };

    const count = settings.particleCount;

    /*
     * ------------------------------------------------------------
     * GPU STORAGE BUFFERS
     * ------------------------------------------------------------
     */

    const initialData = createInitialData(
        count,
        settings.initialSpread,
        settings.initialVelocity
    );

    /*
     * instancedArray() crea un StorageBufferNode.
     *
     * Estos buffers son utilizados directamente por el compute shader
     * y posteriormente pueden convertirse en atributos de render.
     */
    const positionBuffer = instancedArray(
        initialData.positions,
        'vec3'
    );

    const velocityBuffer = instancedArray(
        initialData.velocities,
        'vec3'
    );


    /*
     * ------------------------------------------------------------
     * UNIFORMS
     * ------------------------------------------------------------
     */

    const attractorPos = uniform(
        settings.attractorPosition.clone()
    );

    const mass = uniform(settings.mass);

    const drag = uniform(settings.drag);

    const radialStrength = uniform(
        settings.radialStrength
    );

    const radialSoftening = uniform(
        settings.radialSoftening
    );

    const vortexStrength = uniform(
        settings.vortexStrength
    );

    const vortexSoftening = uniform(
        settings.vortexSoftening
    );

    const turbulenceStrength = uniform(
        settings.turbulenceStrength
    );

    const turbulenceFrequency = uniform(
        settings.turbulenceFrequency
    );

    const maxSpeed = uniform(
        settings.maxSpeed
    );

    const dt = uniform(settings.dt);

    const time = uniform(0.0);


    /*
     * ------------------------------------------------------------
     * CURL NOISE POR DIFERENCIAS FINITAS
     * ------------------------------------------------------------
     *
     * Generamos un campo vectorial:
     *
     *     N(p) = snoiseVec3(p)
     *
     * y calculamos:
     *
     * curl(N) =
     *
     * ( dNz/dy - dNy/dz,
     *   dNx/dz - dNz/dx,
     *   dNy/dx - dNx/dy )
     *
     * La construcción como curl garantiza un campo aproximadamente
     * libre de divergencia.
     */

    const curlNoiseFiniteDifference = Fn(
        ({ position, frequency, elapsed }) => {

            const epsilon = float(0.05);

            const p = position
                .mul(frequency)
                .add(vec3(elapsed.mul(0.05)));

            const dx = vec3(epsilon, 0.0, 0.0);
            const dy = vec3(0.0, epsilon, 0.0);
            const dz = vec3(0.0, 0.0, epsilon);

            const noiseXP = snoiseVec3(p.add(dx));
            const noiseXM = snoiseVec3(p.sub(dx));

            const noiseYP = snoiseVec3(p.add(dy));
            const noiseYM = snoiseVec3(p.sub(dy));

            const noiseZP = snoiseVec3(p.add(dz));
            const noiseZM = snoiseVec3(p.sub(dz));

            const invTwoEpsilon =
                float(1.0).div(
                    epsilon.mul(2.0)
                );

            const dX = noiseXP
                .sub(noiseXM)
                .mul(invTwoEpsilon);

            const dY = noiseYP
                .sub(noiseYM)
                .mul(invTwoEpsilon);

            const dZ = noiseZP
                .sub(noiseZM)
                .mul(invTwoEpsilon);

            const curlX = dZ.y.sub(dY.z);

            const curlY = dX.z.sub(dZ.x);

            const curlZ = dY.x.sub(dX.y);

            return vec3(
                curlX,
                curlY,
                curlZ
            );
        }
    );


    /*
     * ------------------------------------------------------------
     * COMPUTE KERNEL
     * ------------------------------------------------------------
     */

    const simulationStep = Fn(() => {

        /*
         * Identificador de la partícula.
         */
        const index = instanceIndex;

        /*
         * Acceso directo al storage buffer.
         */
        const position =
            positionBuffer.element(index);

        const velocity =
            velocityBuffer.element(index);


        /*
         * --------------------------------------------------------
         * POSICIÓN Y VELOCIDAD ACTUALES
         * --------------------------------------------------------
         */

        const p = position.toVar();

        const v = velocity.toVar();


        /*
         * --------------------------------------------------------
         * FUERZA TOTAL
         * --------------------------------------------------------
         */

        const totalForce =
            vec3(0.0).toVar();


        /*
         * --------------------------------------------------------
         * 1. DRAG
         *
         * F_drag = -c_d * v
         * --------------------------------------------------------
         */

        const dragForce =
            v.mul(drag).negate();

        totalForce.addAssign(
            dragForce
        );


        /*
         * --------------------------------------------------------
         * VECTOR HACIA EL ATRACTOR
         *
         * r = attractor - p
         * --------------------------------------------------------
         */

        const r =
            attractorPos
                .sub(p)
                .toVar();

        const rSquared =
            r.dot(r)
                .add(
                    radialSoftening
                        .mul(radialSoftening)
                );

        const distance =
            rSquared.sqrt();


        /*
         * --------------------------------------------------------
         * 2. FUERZA RADIAL
         *
         * F_radial =
         *
         *       k * r
         * -----------------
         *     |r|^3 + s^2
         *
         * El signo de k determina:
         *
         * k > 0 -> atracción
         * k < 0 -> repulsión
         *
         * El denominador suavizado evita singularidad.
         * --------------------------------------------------------
         */

        const denominator =
            distance
                .mul(distance)
                .mul(distance)
                .add(
                    radialSoftening
                        .mul(radialSoftening)
                );

        const radialForce =
            r
                .mul(radialStrength)
                .div(denominator);

        totalForce.addAssign(
            radialForce
        );


        /*
         * --------------------------------------------------------
         * 3. VÓRTICE / FUERZA TANGENCIAL
         *
         * En XY:
         *
         * r_perp = (-ry, rx, 0)
         *
         * F_vortex =
         *
         * alpha * r_perp
         * ----------------
         *     |r| + s
         * --------------------------------------------------------
         */

        const rPerp =
            vec3(
                r.y.negate(),
                r.x,
                0.0
            );

        const vortexDenominator =
            distance
                .add(vortexSoftening);

        const vortexForce =
            rPerp
                .mul(vortexStrength)
                .div(vortexDenominator);

        totalForce.addAssign(
            vortexForce
        );


        /*
         * --------------------------------------------------------
         * 4. TURBULENCIA CURL
         * --------------------------------------------------------
         */

        const curl =
            curlNoiseFiniteDifference({
                position: p,
                frequency: turbulenceFrequency,
                elapsed: time
            });

        const turbulenceForce =
            curl.mul(
                turbulenceStrength
            );

        totalForce.addAssign(
            turbulenceForce
        );


        /*
         * --------------------------------------------------------
         * ACELERACIÓN
         *
         * F = m*a
         * a = F/m
         * --------------------------------------------------------
         */

        const acceleration =
            totalForce
                .div(mass);


        /*
         * --------------------------------------------------------
         * EULER SEMIIMPLÍCITO
         *
         * v(t+dt) = v(t) + a*dt
         * p(t+dt) = p(t) + v(t+dt)*dt
         * --------------------------------------------------------
         */

        const newVelocity =
            v
                .add(
                    acceleration.mul(dt)
                )
                .toVar();


        /*
         * --------------------------------------------------------
         * LIMITACIÓN DE VELOCIDAD
         *
         * Evita explosiones numéricas cuando el usuario aumenta
         * mucho las fuerzas.
         * --------------------------------------------------------
         */

        const speedSquared =
            newVelocity.dot(newVelocity);

        const maxSpeedSquared =
            maxSpeed.mul(maxSpeed);

        const speedScale =
            maxSpeed.div(
                speedSquared.sqrt().max(
                    float(0.0001)
                )
            );

        /*
         * Si speed > maxSpeed, escala la velocidad.
         * Si no, conserva la original.
         */
        newVelocity.assign(
            speedSquared
                .greaterThan(maxSpeedSquared)
                .select(
                    newVelocity.mul(speedScale),
                    newVelocity
                )
        );


        /*
         * --------------------------------------------------------
         * NUEVA POSICIÓN
         * --------------------------------------------------------
         */

        const newPosition =
            p
                .add(
                    newVelocity.mul(dt)
                );


        /*
         * --------------------------------------------------------
         * ESCRITURA GPU
         * --------------------------------------------------------
         */

        position.assign(
            newPosition
        );

        velocity.assign(
            newVelocity
        );

    })().compute(count);


    /*
     * ------------------------------------------------------------
     * CONTROL DE ESCENARIOS
     * ------------------------------------------------------------
     */

    function setScenario(scenario) {

        settings.scenario = scenario;

        switch (scenario) {

            /*
             * 1. INERCIA
             *
             * Sin fuerzas externas.
             */
            case 1:

                radialStrength.value = 0;
                vortexStrength.value = 0;
                turbulenceStrength.value = 0;
                drag.value = 0;

                break;


            /*
             * 2. VIENTO CONSTANTE
             *
             * El viento se representa mediante turbulencia
             * desactivada y un campo constante.
             *
             * Para mantener el kernel general, usamos la posición
             * del atractor como dirección/magnitud del viento.
             */
            case 2:

                radialStrength.value = 0;
                vortexStrength.value = 0;
                turbulenceStrength.value = 0;
                drag.value = 0.04;

                /*
                 * La componente X del atractor actúa como viento.
                 * La componente Y también puede modificarse.
                 */
                break;


            /*
             * 3. ATRACCIÓN RADIAL
             */
            case 3:

                radialStrength.value =
                    Math.abs(settings.radialStrength);

                vortexStrength.value = 0;

                turbulenceStrength.value = 0;

                drag.value =
                    settings.drag;

                break;


            /*
             * 4. REPULSIÓN RADIAL
             */
            case 4:

                radialStrength.value =
                    -Math.abs(settings.radialStrength);

                vortexStrength.value = 0;

                turbulenceStrength.value = 0;

                drag.value =
                    settings.drag;

                break;


            /*
             * 5. VÓRTICE
             */
            case 5:

                radialStrength.value = 0;

                vortexStrength.value =
                    settings.vortexStrength;

                turbulenceStrength.value =
                    settings.turbulenceStrength;

                drag.value =
                    settings.drag;

                break;

            default:

                break;
        }
    }


    /*
     * Modo laboratorio.
     */
    function setLabScenario(scenario) {

        setScenario(scenario);

        /*
         * Viento constante:
         * usamos el atractor como vector de viento.
         */
        if (scenario === 2) {

            radialStrength.value = 0;
            vortexStrength.value = 0;
            turbulenceStrength.value = 0;

        }
    }


    /*
     * ------------------------------------------------------------
     * API PÚBLICA
     * ------------------------------------------------------------
     */

    const api = {

        particleCount: count,

        positionBuffer,
        velocityBuffer,

        attractorPos,

        mass,
        drag,

        radialStrength,
        radialSoftening,

        vortexStrength,
        vortexSoftening,

        turbulenceStrength,
        turbulenceFrequency,

        maxSpeed,
        dt,
        time,

        compute: simulationStep,

        setScenario: setLabScenario,

        setAttractor(x, y, z = 0) {

            attractorPos.value.set(
                x,
                y,
                z
            );
        },

        setRadialStrength(value) {

            radialStrength.value = value;

        },

        setVortexStrength(value) {

            vortexStrength.value = value;

        },

        setTurbulenceStrength(value) {

            turbulenceStrength.value = value;

        },

        setDrag(value) {

            drag.value = value;

        },

        setDeltaTime(value) {

            dt.value = value;

        },

        updateTime(value) {

            time.value = value;

        },

        setMode(mode) {

            settings.mode = mode;

        },

        getSettings() {

            return {
                ...settings,
                attractorPosition:
                    attractorPos.value.clone()
            };

        }

    };


    /*
     * Inicialmente dejamos el sistema en el escenario 3.
     */
    setScenario(3);

    return api;
}


export {
    DEFAULTS
};