/**
 * Panel de control de la Unidad 3.
 *
 * No depende de ninguna librería externa.
 * Genera toda la interfaz directamente desde JavaScript.
 */

const LAB_SCENARIOS = [
    {
        id: 1,
        name: '1 — Inercia',
        description:
            'Sin fuerzas externas. Las partículas conservan su movimiento.'
    },
    {
        id: 2,
        name: '2 — Viento constante',
        description:
            'Campo de fuerza uniforme que desplaza el conjunto.'
    },
    {
        id: 3,
        name: '3 — Atracción radial',
        description:
            'Las partículas son atraídas hacia el atractor.'
    },
    {
        id: 4,
        name: '4 — Repulsión radial',
        description:
            'Las partículas son alejadas del atractor.'
    },
    {
        id: 5,
        name: '5 — Vórtice',
        description:
            'La fuerza tangencial genera movimiento orbital.'
    }
];


function createElement(tag, className, text = '') {

    const element =
        document.createElement(tag);

    if (className) {
        element.className = className;
    }

    if (text) {
        element.textContent = text;
    }

    return element;
}


function createSlider({
    label,
    min,
    max,
    step,
    value,
    onInput
}) {

    const wrapper =
        createElement(
            'div',
            'force-control'
        );

    const header =
        createElement(
            'div',
            'force-control-header'
        );

    const labelElement =
        createElement(
            'label',
            '',
            label
        );

    const valueElement =
        createElement(
            'span',
            'force-value',
            Number(value).toFixed(2)
        );

    const input =
        document.createElement('input');

    input.type = 'range';

    input.min = min;
    input.max = max;
    input.step = step;
    input.value = value;

    input.addEventListener(
        'input',
        () => {

            const numericValue =
                Number(input.value);

            valueElement.textContent =
                numericValue.toFixed(2);

            onInput(
                numericValue
            );

        }
    );

    header.appendChild(labelElement);
    header.appendChild(valueElement);

    wrapper.appendChild(header);
    wrapper.appendChild(input);

    return wrapper;
}


export function createLabPanel({
    simulation,
    onModeChange = () => {},
    onScenarioChange = () => {}
}) {

    /*
     * ------------------------------------------------------------
     * ESTILOS
     * ------------------------------------------------------------
     */

    const style =
        document.createElement('style');

    style.textContent = `
        .force-panel {
            position: fixed;
            top: 18px;
            left: 18px;

            width: 320px;
            max-height: calc(100vh - 36px);

            overflow-y: auto;

            padding: 18px;

            box-sizing: border-box;

            color: #f4f4f4;

            background:
                rgba(10, 12, 18, 0.88);

            border:
                1px solid rgba(255,255,255,0.12);

            border-radius: 14px;

            backdrop-filter:
                blur(14px);

            box-shadow:
                0 20px 60px rgba(0,0,0,0.35);

            font-family:
                Inter,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            z-index: 1000;
        }

        .force-panel::-webkit-scrollbar {
            width: 5px;
        }

        .force-panel::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
        }

        .force-title {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
        }

        .force-subtitle {
            margin-top: 4px;
            margin-bottom: 16px;

            color:
                rgba(255,255,255,0.55);

            font-size: 12px;
            line-height: 1.45;
        }

        .force-section {
            margin-top: 16px;
            padding-top: 14px;

            border-top:
                1px solid rgba(255,255,255,0.08);
        }

        .force-section-title {
            margin-bottom: 9px;

            font-size: 11px;
            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: 0.12em;

            color:
                rgba(255,255,255,0.45);
        }

        .force-mode-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 7px;
        }

        .force-button {
            appearance: none;

            padding: 9px 8px;

            border:
                1px solid rgba(255,255,255,0.12);

            border-radius: 8px;

            background:
                rgba(255,255,255,0.06);

            color: #eee;

            cursor: pointer;

            font-size: 12px;

            transition:
                background 120ms ease,
                border-color 120ms ease;
        }

        .force-button:hover {
            background:
                rgba(255,255,255,0.1);
        }

        .force-button.active {
            background:
                rgba(255,255,255,0.16);

            border-color:
                rgba(255,255,255,0.35);
        }

        .force-scenario {
            width: 100%;

            padding: 9px;

            border:
                1px solid rgba(255,255,255,0.12);

            border-radius: 8px;

            background:
                rgba(255,255,255,0.06);

            color: white;

            outline: none;

            font-size: 12px;
        }

        .force-scenario option {
            color: #111;
            background: white;
        }

        .force-description {
            margin-top: 8px;

            color:
                rgba(255,255,255,0.5);

            font-size: 11px;
            line-height: 1.45;
        }

        .force-control {
            margin-bottom: 14px;
        }

        .force-control-header {
            display: flex;
            justify-content: space-between;

            margin-bottom: 6px;

            font-size: 12px;
        }

        .force-value {
            color:
                rgba(255,255,255,0.65);

            font-variant-numeric:
                tabular-nums;
        }

        .force-control input[type="range"] {
            width: 100%;

            margin: 0;

            accent-color:
                #ffffff;

            cursor: pointer;
        }

        .force-pointer-info {
            padding: 10px;

            border-radius: 8px;

            background:
                rgba(255,255,255,0.05);

            color:
                rgba(255,255,255,0.55);

            font-size: 11px;

            line-height: 1.5;
        }

        .force-status {
            margin-top: 14px;

            font-size: 10px;

            color:
                rgba(255,255,255,0.35);
        }
    `;

    document.head.appendChild(style);


    /*
     * ------------------------------------------------------------
     * PANEL
     * ------------------------------------------------------------
     */

    const panel =
        createElement(
            'aside',
            'force-panel'
        );

    const title =
        createElement(
            'h1',
            'force-title',
            'Instrumento de Fuerzas'
        );

    const subtitle =
        createElement(
            'div',
            'force-subtitle',
            'Unidad 3 · The Nature of Code · GPU Particle System'
        );

    panel.appendChild(title);
    panel.appendChild(subtitle);


    /*
     * ------------------------------------------------------------
     * MODO
     * ------------------------------------------------------------
     */

    const modeSection =
        createElement(
            'section',
            'force-section'
        );

    const modeTitle =
        createElement(
            'div',
            'force-section-title',
            'Modo'
        );

    const modeButtons =
        createElement(
            'div',
            'force-mode-buttons'
        );

    const labButton =
        createElement(
            'button',
            'force-button active',
            'LAB'
        );

    const performanceButton =
        createElement(
            'button',
            'force-button',
            'PERFORMANCE'
        );

    modeButtons.appendChild(labButton);
    modeButtons.appendChild(performanceButton);

    modeSection.appendChild(modeTitle);
    modeSection.appendChild(modeButtons);

    panel.appendChild(modeSection);


    /*
     * ------------------------------------------------------------
     * LABORATORIO
     * ------------------------------------------------------------
     */

    const labSection =
        createElement(
            'section',
            'force-section'
        );

    const labTitle =
        createElement(
            'div',
            'force-section-title',
            'Escenarios de laboratorio'
        );

    const scenarioSelect =
        document.createElement('select');

    scenarioSelect.className =
        'force-scenario';

    const description =
        createElement(
            'div',
            'force-description'
        );

    LAB_SCENARIOS.forEach(
        scenario => {

            const option =
                document.createElement('option');

            option.value =
                scenario.id;

            option.textContent =
                scenario.name;

            scenarioSelect.appendChild(
                option
            );
        }
    );

    function updateDescription(id) {

        const scenario =
            LAB_SCENARIOS.find(
                item =>
                    item.id === Number(id)
            );

        if (!scenario) return;

        description.textContent =
            scenario.description;
    }

    scenarioSelect.addEventListener(
        'change',
        () => {

            const scenario =
                Number(
                    scenarioSelect.value
                );

            simulation.setScenario(
                scenario
            );

            updateDescription(
                scenario
            );

            onScenarioChange(
                scenario
            );
        }
    );

    labSection.appendChild(labTitle);
    labSection.appendChild(scenarioSelect);
    labSection.appendChild(description);

    panel.appendChild(labSection);


    /*
     * ------------------------------------------------------------
     * PERFORMANCE
     * ------------------------------------------------------------
     */

    const performanceSection =
        createElement(
            'section',
            'force-section'
        );

    const performanceTitle =
        createElement(
            'div',
            'force-section-title',
            'Controles expresivos'
        );

    performanceSection.appendChild(
        performanceTitle
    );


    /*
     * Control 1:
     * Fuerza radial
     *
     * Positivo = atracción
     * Negativo = repulsión
     */
    const radialControl =
        createSlider({
            label: 'Fuerza radial',
            min: -10,
            max: 10,
            step: 0.1,
            value: 5,

            onInput: value => {

                simulation.setRadialStrength(
                    value
                );

            }
        });


    /*
     * Control 2:
     * Vórtice + turbulencia.
     *
     * El valor se divide entre ambos efectos para que
     * un solo gesto controle la complejidad del campo.
     */
    const vortexControl =
        createSlider({
            label: 'Vórtice / turbulencia',
            min: 0,
            max: 5,
            step: 0.05,
            value: 1.5,

            onInput: value => {

                simulation.setVortexStrength(
                    value
                );

                simulation.setTurbulenceStrength(
                    value * 0.18
                );

            }
        });


    /*
     * Control 3:
     * Drag.
     */
    const dragControl =
        createSlider({
            label: 'Resistencia / drag',
            min: 0,
            max: 1.5,
            step: 0.01,
            value: 0.18,

            onInput: value => {

                simulation.setDrag(
                    value
                );

            }
        });


    performanceSection.appendChild(
        radialControl
    );

    performanceSection.appendChild(
        vortexControl
    );

    performanceSection.appendChild(
        dragControl
    );

    panel.appendChild(
        performanceSection
    );


    /*
     * ------------------------------------------------------------
     * INFORMACIÓN DEL PUNTERO
     * ------------------------------------------------------------
     */

    const pointerInfo =
        createElement(
            'div',
            'force-pointer-info',
            'Mueve el puntero sobre el campo para desplazar el atractor espacial.'
        );

    panel.appendChild(
        pointerInfo
    );


    /*
     * ------------------------------------------------------------
     * ESTADO
     * ------------------------------------------------------------
     */

    const status =
        createElement(
            'div',
            'force-status',
            `GPU · ${simulation.particleCount.toLocaleString()} partículas`
        );

    panel.appendChild(status);


    document.body.appendChild(
        panel
    );


    /*
     * ------------------------------------------------------------
     * EVENTOS DE MODO
     * ------------------------------------------------------------
     */

    function setMode(mode) {

        const isLab =
            mode === 'lab';

        labButton.classList.toggle(
            'active',
            isLab
        );

        performanceButton.classList.toggle(
            'active',
            !isLab
        );

        labSection.style.display =
            isLab
                ? 'block'
                : 'none';

        performanceSection.style.display =
            isLab
                ? 'none'
                : 'block';

        simulation.setMode(
            mode
        );

        onModeChange(
            mode
        );
    }


    labButton.addEventListener(
        'click',
        () => setMode('lab')
    );

    performanceButton.addEventListener(
        'click',
        () => setMode('performance')
    );


    /*
     * ------------------------------------------------------------
     * API DEL PANEL
     * ------------------------------------------------------------
     */

    return {

        element: panel,

        setMode,

        setScenario(scenario) {

            scenarioSelect.value =
                String(scenario);

            updateDescription(
                scenario
            );

            simulation.setScenario(
                scenario
            );
        },

        setPointerPosition(x, y) {

            pointerInfo.textContent =
                `Atractor · X: ${x.toFixed(2)} · Y: ${y.toFixed(2)}`;

        },

        destroy() {

            panel.remove();
            style.remove();

        }

    };
}